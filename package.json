{
	"name": "laboratory-api",
	"version": "0.0.1",
	"description": "Multi-tenant MyLab backend",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"build:local": "cross-env NODE_ENV=local nest build",
		"build:staging": "cross-env NODE_ENV=staging nest build",
		"build:production": "cross-env NODE_ENV=production nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "cross-env NODE_ENV=local nest start --watch",
		"start:debug": "cross-env NODE_ENV=local nest start --debug --watch",
		"start:staging": "cross-env NODE_ENV=staging TZ=Asia/Manila node dist/src/main",
		"start:prod": "cross-env NODE_ENV=production TZ=Asia/Manila node dist/src/main",
		"migrate-latest": "cross-env NODE_ENV=local TZ=Asia/Manila npx knex migrate:latest",
		"migrate-latest:staging": "cross-env NODE_ENV=staging TZ=Asia/Manila npx knex migrate:latest",
		"migrate-latest:production": "cross-env NODE_ENV=production TZ=Asia/Manila npx knex migrate:latest",
		"migrate-rollback": "cross-env NODE_ENV=local TZ=Asia/Manila npx knex migrate:rollback",
		"migrate-rollback:staging": "cross-env NODE_ENV=staging TZ=Asia/Manila npx knex migrate:rollback",
		"migrate-rollback:production": "cross-env NODE_ENV=production TZ=Asia/Manila npx knex migrate:rollback",
		"seed-latest": "cross-env NODE_ENV=local TZ=Asia/Manila npx knex seed:run",
		"seed-latest:staging": "cross-env NODE_ENV=staging TZ=Asia/Manila npx knex seed:run",
		"seed-latest:production": "cross-env NODE_ENV=production TZ=Asia/Manila npx knex seed:run",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:e2e": "cross-env NODE_ENV=test TZ=Asia/Manila jest --config ./test/jest-e2e.json --runInBand"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^11.1.27",
		"@nestjs/schedule": "^6.0.1",
		"@nestjs/swagger": "^11.2.0",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/websockets": "^11.1.27",
		"@types/nodemailer": "^8.0.1",
		"bcrypt": "^6.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"date-fns": "^4.1.0",
		"dotenv": "^16.4.5",
		"ejs": "^3.1.10",
		"email-templates": "^13.0.1",
		"jsonwebtoken": "^9.0.2",
		"knex": "^3.1.0",
		"moment-timezone": "^0.6.0",
		"morgan": "^1.10.0",
		"nodemailer": "^9.0.3",
		"objection": "^3.1.5",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.16.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"tesseract.js": "^7.0.0",
		"uuid": "^11.0.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/bcrypt": "^5.0.2",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/morgan": "^1.9.9",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.10.7",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"cross-env": "^10.1.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
