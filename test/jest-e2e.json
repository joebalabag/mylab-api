{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec\\.ts$",
	"transform": {
		"^.+\\.(t|j)s$": ["ts-jest", { "isolatedModules": true }]
	},
	"moduleNameMapper": {
		"^@/(.*)$": "<rootDir>/src/$1"
	},
	"globalSetup": "<rootDir>/test/global-setup.ts",
	"testTimeout": 60000
}
