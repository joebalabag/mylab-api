<p style="font-size:16px;margin:0 0 12px">Hi <%= owner_name %>,</p>
<p style="margin:0 0 12px">We've received your subscription payment for <strong><%= store_name %></strong>. It is now <strong>pending review</strong> by our team — you'll get another email as soon as it's approved (or if we need more information).</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:separate;border-spacing:0;margin:16px 0 20px;background:#f8fafc;border-radius:8px;overflow:hidden;width:100%;max-width:520px">
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;width:180px">Plan</td>
		<td style="padding:10px 16px;font-weight:600"><%= plan_name %></td>
	</tr>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Amount paid</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600;border-top:1px solid #e2e8f0"><%= amount_paid %></td>
	</tr>
	<% if (payment_method_name) { %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Method</td>
		<td style="padding:10px 16px;border-top:1px solid #e2e8f0"><%= payment_method_name %></td>
	</tr>
	<% } %>
	<% if (payment_reference_number) { %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Reference #</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;border-top:1px solid #e2e8f0"><%= payment_reference_number %></td>
	</tr>
	<% } %>
	<% if (payment_datetime) { %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Paid at</td>
		<td style="padding:10px 16px;border-top:1px solid #e2e8f0"><%= payment_datetime %></td>
	</tr>
	<% } %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Submitted</td>
		<td style="padding:10px 16px;border-top:1px solid #e2e8f0"><%= submitted_at %></td>
	</tr>
</table>

<% if (receipt_attached) { %>
<p style="margin:0 0 12px;color:#0f172a;font-size:13px">A copy of the receipt you uploaded is attached to this email for your records.</p>
<% } %>

<p style="margin:0;color:#64748b;font-size:13px">If you did not submit this payment, please contact us right away.</p>
