<p style="font-size:16px;margin:0 0 12px">Hi <%= patient_name %>,</p>
<p style="margin:0 0 12px">Your laboratory result from <strong><%= tenant_name %></strong> is ready. A copy of the report is attached to this email as a PDF.</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:16px 0;border-collapse:collapse">
	<tr>
		<td style="padding:4px 12px 4px 0;font-size:13px;color:#64748b">Lab number</td>
		<td style="padding:4px 0;font-size:13px;font-family:ui-monospace,Menlo,Consolas,monospace"><%= lab_number %></td>
	</tr>
	<% if (test_summary) { %>
	<tr>
		<td style="padding:4px 12px 4px 0;font-size:13px;color:#64748b">Test(s)</td>
		<td style="padding:4px 0;font-size:13px"><%= test_summary %></td>
	</tr>
	<% } %>
	<tr>
		<td style="padding:4px 12px 4px 0;font-size:13px;color:#64748b">Finalized</td>
		<td style="padding:4px 0;font-size:13px"><%= finalized_at %></td>
	</tr>
</table>
<p style="font-size:13px;color:#64748b;margin:0 0 6px">Please review the attached PDF and share it with your physician. If you did not request this laboratory examination, please contact <%= tenant_name %> so we can look into it.</p>
