<p style="font-size:16px;margin:0 0 12px">Hi <%= name %>,</p>
<p style="margin:0 0 12px">Your account for <strong><%= store_name %></strong> is now active. Please change the password after your first login.</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:separate;border-spacing:0;margin:16px 0 20px;background:#f8fafc;border-radius:8px;overflow:hidden">
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px">Store code</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600"><%= store_code %></td>
	</tr>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Username</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600;border-top:1px solid #e2e8f0"><%= username %></td>
	</tr>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Password</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600;border-top:1px solid #e2e8f0"><%= password %></td>
	</tr>
</table>

<p style="margin:0 0 12px">Your trial is active<% if (trial_expiry) { %> and expires on <strong><%= trial_expiry %></strong><% } %>. You have full admin access to every part of the app.</p>

<p style="margin:24px 0">
	<a href="<%= login_url %>" style="display:inline-block;padding:12px 20px;background:#4f46e5;color:#ffffff;border-radius:8px;text-decoration:none;font-weight:600">Go to login</a>
</p>

