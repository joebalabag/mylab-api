<p style="font-size:16px;margin:0 0 12px">Hi <%= owner_name %>,</p>
<p style="margin:0 0 12px">Your subscription payment for <strong><%= store_name %></strong> could not be approved.</p>

<div style="margin:16px 0 20px;padding:14px 16px;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;color:#991b1b">
	<div style="font-size:12px;text-transform:uppercase;letter-spacing:0.06em;color:#991b1b;margin:0 0 4px">Reason</div>
	<div style="font-size:14px;color:#7f1d1d;white-space:pre-line"><%= rejection_reason %></div>
</div>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse:separate;border-spacing:0;margin:16px 0 20px;background:#f8fafc;border-radius:8px;overflow:hidden;width:100%;max-width:520px">
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;width:180px">Plan</td>
		<td style="padding:10px 16px;font-weight:600"><%= plan_name %></td>
	</tr>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Amount paid</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;font-weight:600;border-top:1px solid #e2e8f0"><%= amount_paid %></td>
	</tr>
	<% if (payment_reference_number) { %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Reference #</td>
		<td style="padding:10px 16px;font-family:ui-monospace,Menlo,Consolas,monospace;border-top:1px solid #e2e8f0"><%= payment_reference_number %></td>
	</tr>
	<% } %>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Reviewed by</td>
		<td style="padding:10px 16px;border-top:1px solid #e2e8f0"><%= rejected_by_name %></td>
	</tr>
	<tr>
		<td style="padding:10px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0">Reviewed at</td>
		<td style="padding:10px 16px;border-top:1px solid #e2e8f0"><%= rejected_at %></td>
	</tr>
</table>

<p style="margin:0 0 12px">Please review the reason above, then submit a new payment through your dashboard. We're happy to help if you have questions — just reply to this email.</p>

<p style="margin:24px 0">
	<a href="<%= login_url %>" style="display:inline-block;padding:12px 20px;background:#4f46e5;color:#ffffff;border-radius:8px;text-decoration:none;font-weight:600">Submit a new payment</a>
</p>
