{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{ "include": "common/mailer/templates/**/*", "outDir": "dist/src" },
			{ "include": "app/lab-report/templates/**/*", "outDir": "dist/src" }
		],
		"watchAssets": true
	}
}
