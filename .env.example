NODE_ENV=local
PORT=3010

# ── Database ─────────────────────────────────────────────────────
DB_SERVER=127.0.0.1
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_DATABASE=mylab
DB_PORT=5432

# ── Auth (JWT) ───────────────────────────────────────────────────
# JWT_SECRET must be a long random string in every environment.
JWT_SECRET=REPLACE_ME_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=1d

# ── Payment-slip AI extraction ───────────────────────────────────
# tesseract → free, in-process OCR (default; downloads ~10 MB English
#             language data on first run, cached locally afterward)
# none      → skip extraction entirely; payment is created with all
#             AI-derived fields = null
AI_VISION_PROVIDER=tesseract

# ── Cron schedules ───────────────────────────────────────────────
# Standard 5-field cron expression (min hour day-of-month month day-of-week).
# Examples: "0 * * * *" hourly (default), "*/15 * * * *" every 15 min,
#           "0 */6 * * *" every 6 hours, "0 3 * * *" daily at 03:00.
SUBSCRIPTION_PROMOTION_CRON=0 * * * *

# ── SMTP (for tenant self-registration verification / welcome emails) ─
# When blank, the mailer falls back to console-logging the message.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=no-reply@example.com

# Base URL of the frontend — used to build the verification link.
APP_URL=http://localhost:5173

# Comma-separated list of origins allowed to hit the API (CORS).
# When empty, main.ts falls back to a built-in default (localhost + prod + staging).
# Override per environment. Examples:
#   local:      CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   staging:    CORS_ORIGINS=https://staging-mylab.edgetechph.net
#   production: CORS_ORIGINS=https://mylab.edgetechph.net
CORS_ORIGINS=

# ── PayPal (auto-approved subscription payments) ─────────────────
# PAYPAL_ENV=sandbox uses https://api-m.sandbox.paypal.com; live uses
# https://api-m.paypal.com. Client id/secret come from your REST app
# in the PayPal developer dashboard.
#
# PAYPAL_WEBHOOK_ID is the id assigned when you register the webhook
# URL (POST /api/public/paypal/webhook) — REQUIRED for verification.
# Without it, the webhook route drops every event.
#
# Subscribe the webhook to at least PAYMENT.CAPTURE.COMPLETED. Refund
# / dispute events are received-and-logged only for now.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
